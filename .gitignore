# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# respaldos locales (contienen datos de usuarios)
/backups/

# scripts sueltos archivados (fuera del build)
/_archivo/

# configuración local de Claude Code y volcados de base de datos (sensibles)
/.claude/settings.local.json
*.dump

# estado local de los importadores (necesario para --rollback; no se versiona)
/data/catalogo-100/pre-import-state.json
/data/inventario-real/pre-import-state.json
